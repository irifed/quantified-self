# =====================================================
# Database
# =====================================================

POSTGRES_DB=health
POSTGRES_USER=health
POSTGRES_PASSWORD=change_me

DATABASE_HOST=timescaledb
DATABASE_PORT=5432

# Optional override. Containers construct this safely from the fields above.
# DATABASE_URL=postgresql+psycopg://health:change_me@timescaledb:5432/health

# =====================================================
# Withings
# =====================================================

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=http://localhost:8000/callback
WITHINGS_OAUTH_HOST=127.0.0.1
WITHINGS_OAUTH_PORT=8000
WITHINGS_ACCESS_TOKEN=
WITHINGS_REFRESH_TOKEN=

# Initial history window. Subsequent syncs overlap by one day and upsert.
INITIAL_SYNC_DAYS=3650

# =====================================================
# Scheduler
# =====================================================

SYNC_INTERVAL_HOURS=6

# =====================================================
# Application
# =====================================================

TZ=Europe/Amsterdam

LOG_LEVEL=INFO

# =====================================================
# Grafana
# =====================================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
